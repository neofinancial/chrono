{
  "name": "chrono-monorepo",
  "description": "Monorepo for chrono packages",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=10.6.2"
  },
  "keywords": [],
  "author": "Neo Financial Engineering <engineering@neofinancial.com>",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.30.0",
  "scripts": {
    "clean": "pnpm --recursive run clean && rimraf node_modules",
    "build": "pnpm --recursive run build",
    "typecheck": "pnpm --recursive run typecheck",
    "check": "biome check",
    "format": "biome format --write",
    "lint": "biome lint",
    "prepare": "husky",
    "test": "pnpm --recursive run test",
    "publish": "pnpm i && pnpm build && pnpm publish -r",
    "publish:alpha": "pnpm i && pnpm build && pnpm publish -r --tag alpha"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@faker-js/faker": "^9.9.0",
    "@types/node": "^22.20.1",
    "fishery": "^2.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "rimraf": "^6.1.3",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "vitest-mock-extended": "^5.1.1"
  }
}
